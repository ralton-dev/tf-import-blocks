        "name": "core",
        "region": "eu-west-1",
        "accountId": "111122223333",
        "raw": { "id": "vpc-0a1b2c3d4e5f60718", "cidrBlock": "10.0.0.0/16" }
      }
    },
    {
      "why": "atlas stores the queue ARN; the import id is the queue URL, derivable from it",
