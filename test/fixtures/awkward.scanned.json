      "expectedType": "aws_vpc",
      "expectedId": "vpc-0a1b2c3d4e5f60718",
      "doc": "r/vpc.html.markdown — import VPCs using the VPC `id`",
      "subject": {
        "kind": "vpc",
        "id": "vpc-0a1b2c3d4e5f60718",
