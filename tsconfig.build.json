// Emit configuration, separate from `tsconfig.json` on purpose.
//
// `tsconfig.json` sets `noEmit: true`, because typechecking and emitting want
// different `include` sets: typechecking covers `src` and `test`, while
// anything emitted into `dist/` is published. This file is the only place that
// emits, and it is the reason the two are separate rather than one config with
// a flag flipped by hand.
//
// The paragraph that used to be here described `noEmit` as inherited from a
// monorepo-root `tsconfig.base.json` shared with three sibling workspaces.
// Neither the file nor the siblings exist any more; the options are inlined in
// `tsconfig.json`.
//
// `include` is narrowed to `src` so `test/` never reaches `dist/`: the tests
// import from relative paths inside the package and would otherwise emit a
// parallel `dist/test/` tree that the `exports` map does not surface and no one
// would ever run.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    // Both maps are on so a consumer stepping into the package lands on the
    // TypeScript that produced the line rather than on emitted JavaScript. That
    // only works if the sources are actually there, which is why `files` in
    // `package.json` ships `src/` — a map pointing at a file the tarball omits
    // is worse than no map, because the editor reports a missing file instead
    // of quietly showing JavaScript.
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src"]
}
