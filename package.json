{
  "name": "tf-import-blocks",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Terraform import-block generation from a state file or from a scanned resource, driven by a per-type import-id rule table",
  "keywords": [
    "terraform",
    "import",
    "import-block",
    "tfstate",
    "terraform-state",
    "aws",
    "hcl",
    "iac",
    "drift",
    "state-migration"
  ],
  "license": "MIT",
  "author": "Ben Ralton",
  "homepage": "https://github.com/ralton-dev/tf-import-blocks#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ralton-dev/tf-import-blocks.git"
  },
  "bugs": {
    "url": "https://github.com/ralton-dev/tf-import-blocks/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "test/fixtures",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "find test -name '*.test.ts' -exec tsx --test {} +"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
